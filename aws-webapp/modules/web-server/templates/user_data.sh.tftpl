#!/bin/bash
set -euxo pipefail

dnf install -y nginx

# Query instance metadata using an IMDSv2 session token
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

cat > /usr/share/nginx/html/index.html <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${name_prefix}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 80px auto; padding: 0 20px; color: #222; }
    h1 { font-weight: 500; }
    td { padding: 6px 16px 6px 0; }
    td:first-child { color: #777; }
  </style>
</head>
<body>
  <h1>Deployed with Terraform</h1>
  <p>This server and all of its networking were provisioned entirely as code.</p>
  <table>
    <tr><td>Environment</td><td>${environment}</td></tr>
    <tr><td>Instance ID</td><td>$INSTANCE_ID</td></tr>
    <tr><td>Availability zone</td><td>$AZ</td></tr>
  </table>
</body>
</html>
HTML

systemctl enable --now nginx
